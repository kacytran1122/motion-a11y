{
  "name": "motion-a11y",
  "version": "0.2.0",
  "description": "Accessibility linter for animation code. Finds motion that can trigger vestibular disorders and seizures in Framer Motion, Motion, GSAP, Lottie and the Web Animations API.",
  "keywords": [
    "a11y",
    "accessibility",
    "animation",
    "ci",
    "framer-motion",
    "gsap",
    "linter",
    "lottie",
    "motion",
    "prefers-reduced-motion",
    "seizure",
    "static-analysis",
    "vestibular",
    "wcag"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "motion-a11y": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "precoverage": "npm run build",
    "coverage": "node --import tsx --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='bench/**' --test-coverage-exclude='dist/**' --test-coverage-exclude='src/cli.ts' --test-coverage-exclude='src/types.ts' --test-coverage-lines=98 --test-coverage-functions=97 --test-coverage-branches=92 --test test/*.test.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "publint && attw --pack .",
    "smoke": "node scripts/smoke.mjs",
    "bench": "node --expose-gc bench/bench.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run coverage && npm run smoke && npm run validate && npm audit --audit-level=high && node dist/cli.js src",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.25.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsup": "^8.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Kacy Tran (https://github.com/kacytran1122)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kacytran1122/motion-a11y.git"
  },
  "bugs": {
    "url": "https://github.com/kacytran1122/motion-a11y/issues"
  },
  "homepage": "https://github.com/kacytran1122/motion-a11y#readme",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "publishConfig": {
    "access": "public"
  }
}
